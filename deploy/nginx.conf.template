# Rendered by the nginx image's entrypoint (envsubst) into /etc/nginx/conf.d/default.conf.
# Variables: PORT (injected by Railway), BACKEND_ORIGIN, DNS_RESOLVER (defaults set in the Dockerfile).

# Rate-limit key: the LAST X-Forwarded-For entry, i.e. the address the platform's edge saw. The first entry is
# client-controlled and would let anyone dodge the limits by sending a header of their own.
map $http_x_forwarded_for $client_ip {
    "~(?<last>[^,\s]+)\s*$" $last;
    default                 $remote_addr;
}

limit_req_zone $client_ip zone=api:10m   rate=20r/s;
limit_req_zone $client_ip zone=login:10m rate=10r/m;
# The Git forge relay makes an outbound request per call (up to 10 s each), so it gets a much tighter budget than /api/.
limit_req_zone $client_ip zone=forge:10m rate=5r/s;
limit_req_status 429;

server {
    listen ${PORT};
    listen [::]:${PORT};

    root /usr/share/nginx/html;
    index index.html;

    # The backend is reached by its private hostname. nginx resolves it per request through the platform DNS
    # (a variable in proxy_pass forces that); without this it would resolve once at startup, or fail to.
    resolver ${DNS_RESOLVER} valid=10s ipv6=on;

    # A first sync can carry every task and project in one request.
    client_max_body_size 8m;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    location = /healthz {
        access_log off;
        return 200 "ok\n";
    }

    # Only /api/ reaches the backend: its actuator and anything else stay unreachable from outside.
    location ~ ^/api/auth/(login|signup)$ {
        limit_req zone=login burst=5 nodelay;
        set $backend "${BACKEND_ORIGIN}";
        include /etc/nginx/proxy-api.conf;
    }

    location = /api/forge/relay {
        limit_req zone=forge burst=20 nodelay;
        set $backend "${BACKEND_ORIGIN}";
        include /etc/nginx/proxy-api.conf;
    }

    location /api/ {
        limit_req zone=api burst=40 nodelay;
        set $backend "${BACKEND_ORIGIN}";
        include /etc/nginx/proxy-api.conf;
    }

    # Hashed build output never changes under the same name.
    location ~* \.(?:js|css|woff2?|ico|png|svg)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    location / {
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ =404;
    }
}
